# Copy to .env and fill in. Names are fixed by internal/config/config.go.
# docker-compose.yml reads this file to expand ${VAR}.

# ---------- provider ----------
# mock = no key needed, runs the full pipeline offline. Start here.
LLM_PROVIDER=mock

# A school gateway is almost always OpenAI-compatible: point BaseURL at its /v1
# and use the key the school issued. Only these two values change between
# providers.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# Cheaper model for history summarisation; defaults to LLM_MODEL when unset.
LLM_SUMMARY_MODEL=

# Verified OpenAI-compatible endpoints:
#   OPENAI_BASE_URL=https://api.siliconflow.cn/v1
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OPENAI_BASE_URL=http://127.0.0.1:11434/v1     # Ollama
#
# ECNU gateway (verified working: streaming, stream_options.include_usage, and
# tool calling all behave exactly as OpenAI specifies, so no adapter is needed):
#   OPENAI_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
#   LLM_MODEL=ecnu-plus            # main conversational model
#   LLM_SUMMARY_MODEL=ecnu-max     # or the same model; both stream usage
#   GET /models lists: ecnu-max, ecnu-plus, ecnu-embedding-small,
#   ecnu-embedding-vl, ecnu-rerank, ecnu-rerank-vl, ecnu-image, ecnu-tts
# Two gotchas worth knowing before trusting a documented model list:
#   * ecnu-decision is documented but returns 401 "获取第三方元数据失败", so a
#     model existing in prose does not mean it is callable. Probe /models and
#     make a real call before configuring it.
#   * Legacy aliases only partly survive: ecnu-turbo still resolves, while
#     ecnu-chat and gpt-4o-mini do not. Do not assume old names kept working.
# Use only ecnu-plus and ecnu-max. The gateway rewrites response.model to a
# backend name (ecnu-plus answers "qwen3.8-flash", ecnu-max "deepseek-flash"),
# but that string is gateway-supplied and not proof of the actual backend, so
# nothing here depends on it: always send the alias you are assigned and ignore
# whatever response.model reports.

# ---------- http ----------
ADDR=:8080
INTERNAL_ADDR=:9090
ALLOWED_ORIGINS=*
# Must exceed the longest generation you allow, and match
# terminationGracePeriodSeconds in the Kubernetes manifest.
SHUTDOWN_GRACE=15s

# ---------- storage ----------
# Host runs: point at localhost. Compose overrides this with the `postgres`
# service name automatically.
DATABASE_URL=postgres://llmchat:llmchat@127.0.0.1:5432/llmchat?sslmode=disable
POSTGRES_USER=llmchat
POSTGRES_PASSWORD=llmchat
POSTGRES_DB=llmchat
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- context budget ----------
# truncate | summarise | hybrid
CTX_STRATEGY=truncate
CTX_MAX_TOKENS=32000
CTX_RESERVE_REPLY=4096
CTX_RESERVE_INPUT=2048
CTX_PIN_FIRST=true
# Must satisfy: CTX_MAX_TOKENS > CTX_RESERVE_REPLY + CTX_RESERVE_INPUT,
# or the service refuses to start rather than shipping amnesiac replies.

# ---------- local-only infra credentials ----------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
